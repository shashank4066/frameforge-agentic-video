# Demo jobs run without an API key. Add your own key for live jobs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Optional free stock footage search. Uploads and the prepared coffee sample
# work without a key. Obtain a free key at https://www.pexels.com/api/.
PEXELS_API_KEY=

# Optional Gemini scripts and neural narration. Use a FREE-TIER Google AI
# Studio project without billing; a key cannot prove the project's billing tier.
# Free studio never requests Gemini images, Veo, or paid search grounding.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Optional external video generation service; see docs/provider-contract.md.
VIDEO_API_URL=
VIDEO_API_KEY=
PROVIDER_TIMEOUT_SECONDS=120

# Local storage persists across application restarts.
DATABASE_PATH=data/frameforge.db
STORAGE_DIR=data/artifacts
QUEUE_BACKEND=local
REDIS_URL=redis://localhost:6379/0
MAX_CONCURRENT_JOBS=2
MAX_STAGE_ATTEMPTS=3

# Use ffmpeg from PATH, or set an absolute executable path.
FFMPEG_PATH=ffmpeg
